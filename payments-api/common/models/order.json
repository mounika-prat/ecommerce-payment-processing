{
  "name": "Order", "plural": "orders", "base": "PersistedModel", "idInjection": true,
  "properties": {
    "customerId": {"type": "number", "required": true},
    "totalAmount": {"type": "number", "required": true},
    "status": {"type": "string", "required": true},
    "createdAt": {"type": "date", "required": true, "defaultFn": "now"}
  },
  "relations": {
    "customer": {"type": "belongsTo", "model": "Customer", "foreignKey": "customerId"},
    "orderItems": {"type": "hasMany", "model": "OrderItem", "foreignKey": "orderId"},
    "payments": {"type": "hasMany", "model": "Payment", "foreignKey": "orderId"}
  },
  "acls": []
}
