    {
        "id": "validate",
        "type": "function",
        "z": "tab",
        "name": "Validate Payment",
        "func": "const payment = typeof msg.payload === \"string\"\n    ? JSON.parse(msg.payload)\n    : msg.payload;\n\nlet failureReason = null;\n\nif (!payment.id) {\n    failureReason = \"Payment ID is missing\";\n}\nelse if (!payment.amount || payment.amount <= 0) {\n    failureReason = \"Payment amount must be greater than 0\";\n}\nelse if (!payment.currency) {\n    failureReason = \"Currency is missing\";\n}\nelse if (![\"INR\", \"USD\", \"EUR\"].includes(payment.currency)) {\n    failureReason = `Unsupported currency: ${payment.currency}`;\n}\nelse if (!payment.fromAccount) {\n    failureReason = \"From account is missing\";\n}\nelse if (!payment.toAccount) {\n    failureReason = \"To account is missing\";\n}\nelse if (payment.fromAccount === payment.toAccount) {\n    failureReason = \"From and To accounts cannot be the same\";\n}\n\nif (failureReason) {\n    payment.status = \"failed\";\n    payment.failureReason = failureReason;\n    msg.payload = payment;\n    node.error(failureReason, msg);\n    return null;\n}\n\npayment.status = \"initiated\";\nmsg.payload = payment;\nreturn msg;",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 120,
        "wires": [
            [
                "fee"
            ],
            [
                "failed"
            ]
        ]
    },
    {
        "id": "fee",
        "type": "function",
        "z": "tab",
        "name": "Calculate Fee",
        "func": "const p=msg.payload; p.fee=Number(p.amount)*0.02; p.netAmount=Number(p.amount)-p.fee; p.status=\"authorized\"; msg.payload=p; return msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 540,
