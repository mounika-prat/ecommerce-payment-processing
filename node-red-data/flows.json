    {
        "id": "f440b68085d356cb",
        "type": "function",
        "z": "tab",
        "name": "Cache Check Function",
        "func": "if (msg.payload === null || msg.payload === undefined) {\n    // Cache MISS\n    msg.cacheHit = false;\n    return [null, msg];\n}\n\n// Cache HIT\nmsg.cacheHit = true;\n\ntry {\n    msg.payload = JSON.parse(msg.payload);\n} catch (err) {\n    node.error(\"Invalid cached payment JSON\", msg);\n    return [null, msg];\n}\n\nreturn [msg, null];\n",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
